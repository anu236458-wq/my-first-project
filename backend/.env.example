# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secure_coaching_institute_jwt_secret_key_2026_change_in_prod

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/institute_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=institute_db
# Set USE_SQLITE_FALLBACK=true to automatically use an embedded file database if PostgreSQL is not yet running
USE_SQLITE_FALLBACK=true

# WhatsApp Business API Configuration
# Options: 'meta' | 'mock' | 'gupshup' | 'wati' | 'interakt' | 'aisensy'
WHATSAPP_PROVIDER=mock

# Meta WhatsApp Cloud API credentials
META_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WHATSAPP_TOKEN=your_meta_permanent_access_token
META_WHATSAPP_TEMPLATE_NAME=student_absence_alert
META_WHATSAPP_LANGUAGE_CODE=en_US

# Third-party WhatsApp Credentials (Optional if using Meta)
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
WATI_API_ENDPOINT=
WATI_ACCESS_TOKEN=
INTERAKT_API_KEY=
AISENSY_API_KEY=

# Institute Settings
INSTITUTE_NAME=Apex Coaching Institute
INSTITUTE_PHONE=+919876543210
